# Copie este arquivo para .env (local) ou configure as mesmas variáveis
# no painel do serviço de hospedagem (ex.: Railway > Variables).

# Local: file:./prisma/dev.db
# Produção (com volume persistente montado em /data): file:/data/dev.db
DATABASE_URL="file:./prisma/dev.db"

# Chave usada para assinar as sessões (gere uma nova e não compartilhe/commite este valor)
# Gerar uma nova: openssl rand -base64 32
SESSION_SECRET=""

# Pasta onde as fotos/vídeos enviados ficam armazenados (fora de /public por segurança)
# Local: ./uploads
# Produção (com volume persistente montado em /data): /data/uploads
UPLOADS_DIR="./uploads"

# Usuário administrador criado pelo seed inicial (roda automaticamente no deploy)
ADMIN_EMAIL=""
ADMIN_NAME="Admin"
ADMIN_PASSWORD=""

# Envio de email (usado em "esqueci minha senha"). Se deixar em branco, o link
# de redefinição só aparece no console do servidor (útil para testar local).
# Exemplo usando Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=seuemail@gmail.com, SMTP_PASSWORD=senha de app do Google (não é a senha normal da conta).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
